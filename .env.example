# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tech_website
DB_USER=root
DB_PASSWORD=

# JWT密钥
JWT_SECRET=your_jwt_secret_key_here

# 服务端口
BACKEND_PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_PORT=3001

# 网站基本信息
SITE_NAME=科技公司官网
SITE_DOMAIN=example.com
ICP_NUMBER=京ICP备xxxxxxxx号

# 上传文件配置
UPLOAD_PATH=./uploads
# MAX_FILE_SIZE=5MB
MAX_FILE_SIZE=unlimited
# Keycloak SSO —— 连接配置（ISSUER_URL/CLIENT_ID/CLIENT_SECRET）在后台「登录管理」页填写，存数据库
# SSO 成功后回跳的后台面板 origin（生产填 https://<后台域名>:23080；留空则按请求推导）
ADMIN_PANEL_ORIGIN=
