# ------------------------------------------------------------------
#  Pailink 自动部署服务配置模板（宝塔 PM2 管理器和 pm2 reload）
#  复制为 deploy/.env 并填入真实值（deploy/.env 已被 .gitignore 忽略）
# ------------------------------------------------------------------

# 部署服务监听端口（可用仅内网/本机访问；要 Gitee 回调需放行该端口）
PORT=3005

# 与 Gitee Webhook 中配置的「密码/令牌」保持一致，用于鉴权。
# 留空 = 不校验（生产请务必设置）
GITEE_TOKEN=your-gitee-webhook-secret

# 服务器上该仓库的部署路径（git clone 所在目录）
DEPLOY_DIR=/var/www/pailink

# 前台/后端在 pm2 里的【进程名】（宝塔 PM2 管理器创建项目时的"项目名称"，
# 或 pm2 list 里到 name 列）。建议用稳定名：pm2 rename 后可持久化。
BACKEND_APP=pailink-backend
FRONTEND_APP=pailink-frontend

# 部署服务自己的 pm2 进程名（与宝塔里给该服务取的名一致）
DEPLOY_SVC=pailink-deploy

# 部署日志路径（默认 deploy/deploy.log）
DEPLOY_LOG=/var/www/pailink/deploy/deploy.log

# （可选）宝塔 node 的 bin 目录，用于 systemctl/pm2 环境下找到 npm。
# 留空则自动探测 /www/server/nodejs/*/bin 里最新版本；填了则优先用。
# 查法：ls /www/server/nodejs/
NODE_BIN=/www/server/nodejs/v18.20.0/bin

# （可选）仅允许这些来源 IP 回调，逗号分隔；留空 = 不限制来源 IP。
ALLOWED_IPS=