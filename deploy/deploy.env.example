# ------------------------------------------------------------------
#  Pailink 自动部署服务配置模板
#  复制为 deploy/.env 并填入真实值（deploy/.env 已被 .gitignore 忽略）
# ------------------------------------------------------------------

# 部署服务监听端口（可仅内网/本机访问，不暴露公网更安全）
PORT=3005

# 与 Gitee Webhook 中配置的「令牌/密码」保持一致，用于鉴权。
# 留空 = 不校验（生产请务必设置）
GITEE_TOKEN=your-gitee-webhook-secret

# 服务器上该仓库的部署路径（git clone 所在目录）
DEPLOY_DIR=/var/www/pailink

# PM2 中前端/后端的进程名（与服务器上 pm2 list 的 name 一致）
BACKEND_APP=pailink-backend
FRONTEND_APP=pailink-frontend

# 本部署服务的进程名（一般保持默认）
DEPLOY_SVC=pailink-deploy

# 部署日志路径（默认 deploy/deploy.log）
DEPLOY_LOG=/var/www/pailink/deploy/deploy.log

# （可选）仅允许这些来源 IP 回调，逗号分隔；留空 = 不限制来源 IP。
# 可填写 Gitee Webhook 的出口 IP 列表以加强防护，见 Gitee 文档。
ALLOWED_IPS=