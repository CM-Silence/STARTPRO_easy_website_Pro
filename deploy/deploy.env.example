# ------------------------------------------------------------------
#  Pailink 自动部署服务配置模板（宝塔：Node 项目 + systemctl）
#  复制为 deploy/.env 并填入真实值（deploy/.env 已被 .gitignore 忽略）
# ------------------------------------------------------------------

# 部署服务监听端口（可用仅内网/本机访问；要 Gitee 回调需放行该端口）
PORT=3005

# 与 Gitee Webhook 中配置的「密码/令牌」保持一致，用于鉴权。
# 留空 = 不校验（生产请务必设置）
GITEE_TOKEN=your-gitee-webhook-secret

# 服务器上该仓库的部署路径（git clone 所在目录）
DEPLOY_DIR=/var/www/pailink

# 前台/后台在宝塔「Node 项目」里的 systemd 单元名。
# 查法：systemctl list-unit-files | grep -i node     （看 name 那列）
# ⚠ 填的是 systemd 单元名，不是面板里随便起的显示名；务必用上面命令确认真实值。
BACKEND_APP=node-pailink-backend
FRONTEND_APP=node-pailink-frontend

# 部署服务自己的 systemd 单元名（宝塔里给该 Node 项目填的名，同样用上条命令确认）
DEPLOY_SVC=node-pailink-deploy

# 部署日志路径（默认 deploy/deploy.log）
DEPLOY_LOG=/var/www/pailink/deploy/deploy.log

# 宝塔 node 的 bin 目录（用于 systemctl 环境下找到 npm）。
# 可选；留空则自动探测 /www/server/nodejs/*/bin 里最新版本。
# 查法：ls /www/server/nodejs/
NODE_BIN=/www/server/nodejs/v18.20.0/bin

# （可选）仅允许这些来源 IP 回调，逗号分隔；留空 = 不限制来源 IP。
ALLOWED_IPS=